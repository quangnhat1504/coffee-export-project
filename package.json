{
  "name": "vietnam-coffee-data-portal",
  "version": "1.0.0",
  "description": "Vietnam Coffee Export Data Analytics Portal - Professional dashboard with real-time data visualization",
  "main": "index.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "python -m app.main",
    "api": "python -m app.main",
    "health": "curl http://localhost:5000/api/health",
    "test:api": "curl http://localhost:5000/api/health && curl http://localhost:5000/api/production",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "etl:core": "python -m data.scripts.sync_core",
    "etl:prices": "python -m data.scripts.sync_prices",
    "etl:all": "python -m data.scripts.sync_all",
    "etl:dry-run": "python -m data.scripts.sync_all --dry-run",
    "etl:public": "python -m data.scripts.sync_public_sources",
    "etl:public:dry-run": "python -m data.scripts.sync_public_sources --dry-run",
    "update:data": "python scripts/auto_update_data.py",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['node_modules','playwright-report','test-results']) fs.rmSync(p,{recursive:true,force:true});\"",
    "reinstall": "npm run clean && npm install"
  },
  "keywords": [
    "coffee",
    "vietnam",
    "export",
    "data",
    "portal",
    "flask",
    "chart.js"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
