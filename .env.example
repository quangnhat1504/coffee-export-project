# Copy this file to .env and fill in your local secrets.
# Never commit .env.

HOST=your-database-host.com
PORT=3306
USER=your-username
PASSWORD=your-secure-password
DB=your-database-name

# Optional SSL certificate path for Aiven Cloud or other secured MySQL hosts.
CA_PEM=C:\path\to\ca.pem

# Optional AI insight endpoint.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=coding-main

# Optional Flask runtime settings.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0
